# Neon 連接字串(Neon 控制台 → Connection string,保留 ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# 訪問密碼
APP_PASSWORD=change-me
# 用於簽名登入令牌的隨機長字串(可用 openssl rand -hex 32 生成)
AUTH_SECRET=please-generate-a-long-random-string
# 登入有效天數(可選,默認 30)
SESSION_DAYS=30

# S3 相容物件儲存(可選,啟用上傳;Neon / R2 / B2 / AWS S3 / MinIO 皆可)
S3_ENDPOINT=
# S3_REGION=          # 不填則從端點解析(R2 自動用 auto)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_BUCKET=inkwell
# S3_MANAGE_CORS=false   # 不自動建 bucket / 設 CORS(R2、權限受限的金鑰用)
# S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=200

# 額外允許直傳的網站來源(逗號分隔,可選)
# CORS_ORIGINS=https://your-domain.com

# AI / MCP:開關與存取權杖存在資料庫(settings 表),登入後在應用內「AI 設定」產生與管理,無需環境變量。
